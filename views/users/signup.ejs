<% layout("/layouts/bolierplate.ejs") %>

<div class="row">
    <h1 class="col-6 offset-3">SIGNUP ON WANDERLUST</h1>

    <div class="col-6 offset-3">

        <form method="POST" action="/signup" novalidate class="needs-validation">

            <!-- USERNAME -->
            <div class="mb-3">
                <label for="username" class="form-label">USERNAME</label>

                <input
                    type="text"
                    id="username"
                    name="username"
                    placeholder="Enter your USERNAME"
                    class="form-control"
                    required
                >

                <div class="valid-feedback">
                    It looks good!
                </div>
            </div>

            <!-- EMAIL -->
            <div class="mb-3">
                <label for="email" class="form-label">EMAIL</label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Enter your email"
                    class="form-control"
                    required
                >

                <div class="valid-feedback">
                    It looks good!
                </div>
              <data class="invalid-feedback">
                Please provide a valid email.
                </data>

            </div>

            <!-- PASSWORD -->
            <div class="mb-3">
                <label for="password" class="form-label">PASSWORD</label>

                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Enter your password"
                    class="form-control"
                    required
                >

                <div class="valid-feedback">
                    It looks good!
                </div>
                <div class = "invalid-feedback">
                   please set as a special character, a number, and a capital letter.

                </div>
    
            </div>

            <button class="btn btn-success">SIGNUP</button>

        </form>

    </div>
</div>