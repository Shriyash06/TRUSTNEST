<% layout("/layouts/bolierplate.ejs") %>
<body>
<div class="row">
    <div class="row col-8 offset-2" >
    <h1> add new route</h1>
    <form method = "post" action = "/visting/<%=visting.id%>?_method=PUT">
        <label for="title" class = "form-label">Title:</label>
        <input type="text" id="title"  class = "form-control"name= "visting[title]" value = "<%= visting.title%>" required><br/><br/><br/>
        
        <label for="description" class = "form-label">Description:</label>
        <textarea id="description"    class = "form-control" name="visting[description]" row = "10" col = "10"  value = "<%= visting.description%>"required></textarea><br/><br/><br/>
          <label for="location" class = "form-label">Location:</label>
        <input type="text" id="location"   class = "form-control" name="visting[location]"value = "<%=visting.location%>" required><br/><br/><br/>
        <div > <label for="price" class = "form-label">Price:</label>
        <input type="number" id="price"    class = "form-control" name="visting[price]"  value = "<%= visting.price%>"required><br/><br/><br/>
                    
        <label for="country" class = "form-label">Country:</label>
        <input type="text" id="country"    class = "form-control" name="visting[country]"  value = "<%=visting.country%>"required><br/><br/><br/></div>
       
        <label for="image" class = "form-label">Image URL:</label>
        <input type="text" id="image"  class = "form-control"name="visting[image]"  value = <%= visting.image.url%>><br/><br/><br/> 
        
        <button type="submit" class = "btn btn-dark mb-5">Create Listing</button>
    </form>
    

</div>
</div>
</body>
