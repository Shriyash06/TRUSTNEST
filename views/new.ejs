<% layout("/layouts/bolierplate.ejs") %>

<body>
  <div class="row">
    <div class="col-8 offset-2">
      <h1>Add New Route</h1>

      <form method="post" action="/visting" novalidate class="needs-validation">

        <!-- Title -->
        <div class="mb-3">
          <label for="title" class="form-label">Title:</label>
          <input type="text" id="title" placeholder="Enter your title" name="visting[title]" class="form-control" required>
          <div class="valid-feedback">Title is valid.</div>
          <div class="invalid-feedback">Please enter a valid title.</div>
        </div>

        <!-- Description -->
        <div class="mb-3">
          <label for="description" class="form-label">Description:</label>
          <textarea id="description" placeholder="Enter your description" name="visting[description]" rows="4" cols="10" class="form-control" required></textarea>
          <div class="invalid-feedback">Please enter a valid description.</div>
        </div>

        <!-- Location -->
        <div class="mb-3">
          <label for="location" class="form-label">Location:</label>
          <input type="text" id="location" placeholder="AGRA, JAIPUR, DELHI" name="visting[location]" class="form-control" required>
          <div class="invalid-feedback">Please enter a valid location.</div>
        </div>

        <!-- Price and Country Row -->
        <div class="row">
          <div class="mb-3 col-4">
            <label for="price" class="form-label">Price:</label>
            <input type="number" id="price" placeholder="Enter your price" name="visting[price]" class="form-control" required>
            <div class="invalid-feedback">Please enter a valid price.</div>
          </div>

          <div class="mb-3 col-8">
            <label for="country" class="form-label">Country:</label>
            <input type="text" id="country" placeholder="INDIA" name="visting[country]" class="form-control" required>
            <div class="invalid-feedback">Please enter a valid country.</div>
          </div>
        </div>

        <!-- Image URL -->
        <div class="mb-3">
          <label for="image" class="form-label">Image URL:</label>
          <input type="text" id="image" placeholder="Enter your image link" name="visting[image]" class="form-control">
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn btn-dark mb-5 add-btn">Create Listing</button>

      </form>
    </div>
  </div>
</body>
