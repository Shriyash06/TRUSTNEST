<% layout("/layouts/bolierplate.ejs") %>
<body>
    
        <div class = "row">
            <div class = "col-8 offset-2">
                <h1> add new route</h1>
    <form method = "post" action = "/visting">
        <div class = "mb-3"><label for="title" class = "form-label">Title:</label>
        <input type="text" id="title"  placeholder="enter your tittle" name= "visting[title]"  class = "form-control"required><br/><br/><br/></div>
        
        <div class = "mb-3"><label for="description" class = "form-label">Description:</label>
        <textarea id="description"   placeholder="enter your descriptiom" name="visting[description]" row = "10" col = "10"  class = "form-control"required></textarea><br/><br/><br/></div>
        <div class = "mb-3"><label for="location" class = "form-label">Location:</label>
        <input type="text" id="location"   placeholder="AGRA ,JAIPUR ,DELHI"  name="visting[location]"  class = "form-control"required><br/><br/><br/>
        </div>
        <div class="row"><div class = "mb-3 col-4" ><label for="price" class = "form-label">Price:</label>
        <input type="number" id="price"   placeholder="enter your price" name="visting[price]" class = "form-control" required><br/><br/><br/></div>
       
        <div class = "mb-3 col-8"> <label for="country" class = "form-label">Country:</label>
        <input type="text" id="country"    placeholder="INDIA" name="visting[country]" class = "form-control" required><br/><br/><br/></div></div>
        
        
        
       <div class = "mb-3"> <label for="image" class = "form-label">Image URL:</label>
        <input type="text" id="image"    placeholder="enter your image link" name="visting[image]" class = "form-control"><br/><br/><br/></div>
       
        
        <button type="submit" class = "btn btn-dark mb-5 add-btn">Create Listing</button>
        </div>
        </div>
    </form>
    
</body>
